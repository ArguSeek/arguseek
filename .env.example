# ArguSeek Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# Required API Keys
# =============================================================================

# Google Custom Search API Key
# Get yours at: https://developers.google.com/custom-search/v1/introduction
GOOGLE_API_KEY=your-google-api-key-here

# Google Custom Search Engine ID
# Create one at: https://programmablesearchengine.google.com/
GOOGLE_CSE_ID=your-custom-search-engine-id-here

# Gemini API Key (optional - will use GOOGLE_API_KEY if not specified)
# Get yours at: https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# Server Configuration
# =============================================================================

# Port to run the server on (default: 8080)
PORT=8080

# Enable debug logging (optional)
# DEBUG=true

# =============================================================================
# Optional: GCP Cloud Run Deployment
# =============================================================================
# Note: This service is designed to be stateless and open by default.
# For GCP Cloud Run deployment, you'll need to set API keys as environment variables
# in your Cloud Run service configuration.
